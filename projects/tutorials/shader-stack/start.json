                  "js": "clip.use(\"centi\");\nsetup(() => size(1280, 720));\nonFrame(({ time }) => {\n  grad(0, 0, 1280, 720);\n  gradColor(0, \"#5dd4ff\");\n  gradColor(0.5, \"#793c93\");\n  gradColor(1, \"#ff6c9a\");\n  rect(0, 0, 1280, 720);\n  col(\"#ffdc63\");\n  lineWidth(14);\n  for (let i = -6; i < 18; i++) {\n    const x = i * 100 + sin(time) * 80;\n    line(x, 0, x + 300, 720);\n  }\n});"
