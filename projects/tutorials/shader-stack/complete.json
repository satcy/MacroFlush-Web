            "clips": [
              {
                "id": "Grade",
                "name": "Grade",
                "kind": "shader",
                "assetId": "Grade-asset",
                "inFrame": 0,
                "outFrame": 240,
                "authoredBy": "human",
                "remoteAssets": [],
                "params": {
                  "contrast": {
                    "key": "contrast",
                    "type": "number",
                    "default": 1.3,
                    "value": 1.3,
                    "min": 0.5,
                    "max": 2,
                    "step": 0.01,
                    "interpolable": true,
                    "group": "custom",
                    "writable": false,
                    "version": 1
                  }
                },
                "source": {
                  "fragmentShader": "precision mediump float;\nvarying vec2 vUv;\nuniform sampler2D inputTexture;\nuniform float contrast;\nvoid main() {\n  vec4 c = texture2D(inputTexture, vUv);\n  vec3 rgb = (c.rgb - 0.5) * contrast + 0.5;\n  gl_FragColor = vec4(clamp(rgb * vec3(1.08, 0.96, 1.12), 0.0, 1.0), c.a);\n}"
                },
                "keyframeTracks": {}
              }
            ]
          },
          {
            "id": "Chromatic-layer",
            "name": "Chromatic",
            "kind": "effect",
            "visible": true,
            "effectInputMode": "below",
            "clips": [
              {
                "id": "Chromatic",
                "name": "Chromatic",
                "kind": "shader",
                "assetId": "Chromatic-asset",
                "inFrame": 0,
                "outFrame": 240,
                "authoredBy": "human",
                "remoteAssets": [],
                "params": {
                  "amount": {
                    "key": "amount",
                    "type": "number",
                    "default": 7,
                    "value": 7,
                    "min": 0,
                    "max": 24,
                    "step": 0.01,
                    "interpolable": true,
                    "group": "custom",
                    "writable": false,
                    "version": 1
                  }
                },
                "source": {
                  "fragmentShader": "precision mediump float;\nvarying vec2 vUv;\nuniform sampler2D inputTexture;\nuniform vec2 resolution;\nuniform float amount;\n\nvoid main() {\n  vec2 shift = vec2(amount / resolution.x, 0.0);\n  vec4 center = texture2D(inputTexture, vUv);\n  float r = texture2D(inputTexture, clamp(vUv + shift, 0.0, 1.0)).r;\n  float b = texture2D(inputTexture, clamp(vUv - shift, 0.0, 1.0)).b;\n  gl_FragColor = vec4(r, center.g, b, center.a);\n}"
                },
                "keyframeTracks": {}
              }
            ]
          },
          {
            "id": "Blur-layer",
            "name": "Blur",
            "kind": "effect",
            "visible": true,
