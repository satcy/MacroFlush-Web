            "clips": [
              {
                "id": "Blur",
                "name": "Blur",
                "kind": "shader",
                "assetId": "Blur-asset",
                "inFrame": 0,
                "outFrame": 240,
                "authoredBy": "human",
                "remoteAssets": [],
                "params": {
                  "radius": {
                    "key": "radius",
                    "type": "number",
                    "default": 8,
                    "value": 8,
                    "min": 0,
                    "max": 24,
                    "step": 0.01,
                    "interpolable": true,
                    "group": "custom",
                    "writable": false,
                    "version": 1
                  }
                },
                "source": {
                  "fragmentShader": "precision mediump float;\nvarying vec2 vUv;\nuniform sampler2D inputTexture;\nuniform vec2 resolution;\nuniform float radius;\nvoid main() {\n  vec2 d = vec2(radius) / resolution;\n  vec4 c = texture2D(inputTexture, vUv) * 0.4;\n  c += texture2D(inputTexture, clamp(vUv + vec2(d.x, 0.0), 0.0, 1.0)) * 0.15;\n  c += texture2D(inputTexture, clamp(vUv - vec2(d.x, 0.0), 0.0, 1.0)) * 0.15;\n  c += texture2D(inputTexture, clamp(vUv + vec2(0.0, d.y), 0.0, 1.0)) * 0.15;\n  c += texture2D(inputTexture, clamp(vUv - vec2(0.0, d.y), 0.0, 1.0)) * 0.15;\n  gl_FragColor = c;\n}"
                },
                "keyframeTracks": {}
              }
            ]
          },
