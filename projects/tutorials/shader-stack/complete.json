                    ],
                    "group": "builtin",
                    "writable": false,
                    "interpolable": false,
                    "space": "pixels",
                    "version": 1
                  }
                },
                "source": {
                  "html": "",
                  "css": "",
                  "js": "clip.use(\"centi\");\nsetup(() => size(1280, 720));\nonFrame(({ time }) => {\n  const ctx = getContext();\n  const g = ctx.createLinearGradient(0, 0, 1280, 720);\n  g.addColorStop(0, \"#5dd4ff\"); g.addColorStop(0.5, \"#793c93\"); g.addColorStop(1, \"#ff6c9a\");\n  ctx.fillStyle = g; ctx.fillRect(0, 0, 1280, 720);\n  ctx.strokeStyle = \"#ffdc63\"; ctx.lineWidth = 14;\n  for (let i = -6; i < 18; i++) {\n    const x = i * 100 + Math.sin(time) * 80;\n    ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x + 300, 720); ctx.stroke();\n  }\n});"
                },
                "keyframeTracks": {}
              }
