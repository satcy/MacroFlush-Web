                  "js": "clip.use(\"centi\");\nclip.defineParams({ panel: { type: \"number\", default: 0 } });\nsetup(() => size(1280, 720));\nonFrame(({ time }) => {\n  clear();\n  const hue = Number(comp.hue ?? 200);\n  const accent = \"hsl(\" + hue + \", 85%, 66%)\";\n  const second = \"hsl(\" + (hue + 60) + \", 85%, 68%)\";\n  if (clip.panel === 0) {\n    col(\"hsl(\" + hue + \", 25%, 8%)\"); fill(); rect(0, 0, 1280, 720);\n    col(accent); font(\"sans-serif\", 78, true);\n    fill(); text(\"ONE HUE\", 70, 160);\n  } else if (clip.panel === 1) {\n    col(accent); lineWidth(14);\n    for (let i = 0; i < 5; i++) {\n      stroke(); oval(365, 430, 40 + i * 26 + sin(time) * 10);\n    }\n  } else {\n    col(second);\n    fill();\n    for (let i = 0; i < 7; i++) rect(730 + i * 50, 280 + sin(time + i * 0.5) * 80, 24, 240);\n  }\n});"
                },
                "keyframeTracks": {}
              }
