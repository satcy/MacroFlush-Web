                  "html": "<canvas id=\"stage\"></canvas>",
                  "css": "html,body{margin:0;width:100%;height:100%;overflow:hidden;background:transparent}canvas{width:100%;height:100%;display:block}",
                  "js": "clip.use(\"centi\");\n\nconst point = vec2(100, 0);\nconst colors = [\"#33ff00\", \"#ff0033\", \"#0055ff\"];\n\nsetup(() => {\n  size(720, 360);\n  bg(0);\n});\n\nonFrame(({ frame }) => {\n  bm(5); // lighten\n  clear();\n\n  for (let index = 0; index <= 2; index += 1) {\n    const rotated = point.rotate((frame + 10000) / (index * 20 + 30));\n\n    grad(\n      cx - rotated.x,\n      cy - rotated.y,\n      cx + rotated.x,\n      cy + rotated.y\n    );\n    gradColor(0, colors[index]);\n    gradColor(1, colors[(index + 1) % colors.length]);\n\n    rect(0, 0, width, height);\n  }\n});"
