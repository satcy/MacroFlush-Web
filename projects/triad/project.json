                  "js": "clip.use(\"centi\");\nclip.color = \"#ffffff\";\nsetup(() => {\n  size(1920, 1080);\n});\n\nonFrame(({ frame }) => {\n  clear();\n  col(clip.color);\n  for (let j = 0; j < 22; j ++ ) {\n    push();\n\n    translate(zmap(cos(frame / (57 + j)), -1, 1, -600, 0), 0);\n    scale(zmap(cos(frame / (53 + j)), -1, 1, 0.5, 1.0), 1);\n\n    for (let i = 0; i < 100; i ++ ) {\n      tri(150, 0, 150, 50, 0, 25);\n      translate(150, 0);\n      scale(zmap(cos(frame / 55 + i / 2), -1, 1, 0.6, 1.5), 1);\n    }\n\n    pop();\n    translate(0, 50);\n  }\n});"
