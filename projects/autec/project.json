                "source": {
                  "html": "<canvas id=\"stage\"></canvas>",
                  "css": "html,body{margin:0;width:100%;height:100%;overflow:hidden;background:transparent}canvas{width:100%;height:100%;display:block}",
                  "js": "clip.use(\"centi\");\nclip.color ??= \"#ffffff\";\nlet shifts=([0,0,0,0,0]);\nlet scales=([1,1,1,1,1]);\nlet defscales=([0, 0.4,0.8,1]);\nclip.radius = 360;\nclip.vsize = [720, 720];\nclip.defineParams({vsize:{interpolable: true}});\nsetup(() => {\n  size(1920, 1080);\n});\n\nonFrame(({ time, frame }) => {\n  let c = frame;\n  let w = clip.vsize[0];\n  let h = clip.vsize[1];\n  const CEP = clip.radius;\n  clr();\n  if(rnd(1)<0.1){\n    let index=floor(rnd(4));\n    shifts[index]=rnd(-1,1);\n    scales[index]=defscales[floor(rnd(4))];\n  }\n  col(255);\n  rect(cx - w/2,cy - h/2,w,h);\n  col(clip.color);\n  const XNUM = floor(w/CEP);\n  const YNUM = floor(h/CEP);\n  const SX = floor(w/XNUM);\n  const SY = floor(h/YNUM);\n  \n  for(let i=0; i<XNUM; i++){\n    for(let j=0; j<YNUM; j++){\n      const IDX = (i + (j * XNUM)) % shifts.length;\n      let f=(c/CEP+shifts[IDX]*PI);\n      _cos=(cos(f)<0?0:cos(f));\n      push();\n      translate(cx-w/2+SX/2+SX*(i),cy-h/2+SY/2+SY*floor(j));\n      rotate(_cos*PI-PI/4);\n      oval(0,0,CEP*0.5*(_cos==0 ? (sqrt(2)-1-0.02)+1 : scales[IDX])-2, _cos*30+4);\n      pop();\n    }\n  }\n}\n);"
