                  "js": "const { scene, new3d } = clip.use(\"centi3d\");\n\nsetup(() => {\n\n  let geometry = new3d(T.BoxGeometry, [36, 36, 420]);\n  let prop = {};\n  prop.color = 0x00FFFF;\n  let material = new3d(T.MeshPhongMaterial, [prop]);\n\n  for (let i = 0; i < 20; i += 1) {\n    let mesh = new3d(T.Mesh, [geometry, material]);\n    mesh.position.x = i * 36 - 36 * 10 + 36 / 2;\n    scene.add(mesh);\n  }\n\n  let directionalLight = new3d(T.DirectionalLight, [0xffffff, 0.5]);\n  directionalLight.position.set(0, 0, 1);\n  scene.add(directionalLight);\n});\n\nonFrame(({ runTime }) => {\n  for (let i = 0; i < 20; i += 1) {\n    scene.children[i].rotation.x = nz(runTime / 2, i / 20) * PI2;\n    scene.children[i].rotation.z = nz(runTime / 2, i / 20) * PI2;\n  }\n});\n"
